APP_NAME="Fraud Guard API"
ENVIRONMENT="development"
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com

FRAUD_THRESHOLD_HIGH=0.70
FRAUD_THRESHOLD_MEDIUM=0.30
MODEL_PATH="app/ml/artifacts/saved_model.pkl"

# Database Configuration
POSTGRES_PASSWORD=fraudpass
DATABASE_URL=postgresql://frauduser:fraudpass@localhost:5432/fraud_audit

PASTE_COUNT_THRESHOLD=3
TYPING_WPM_HIGH=150.0
TYPING_WPM_LOW=10.0
MOUSE_JITTER_LOW=0.05
LOAN_TO_INCOME_RATIO_HIGH=0.50
EXTREME_FINANCIAL_DTI_RATIO=10.0
EXTREME_FINANCIAL_LOAN_AMOUNT=20000.0
EXTREME_FINANCIAL_INCOME_LIMIT=1000.0
EXTREME_FINANCIAL_ANOMALY_WEIGHT=0.75

# Security Authentication (Demo default - rotate for production)
API_KEY=fg-sk-dev-hackathon-key-2026

LLM_PROVIDER="mock"
OPENAI_API_KEY=""
# Leave empty for real OpenAI. Set to https://api.groq.com/openai/v1 to use Groq's free tier instead.
OPENAI_BASE_URL=""
